# Скопируйте в .env и поправьте под себя: cp .env.example .env
# EXPO_PUBLIC_* встраиваются в JS-бандл при сборке — секреты сюда класть нельзя.

# Базовый URL FastAPI-бэкенда, без завершающего слэша.
# Симулятор iOS видит localhost хоста; эмулятор Android — через 10.0.2.2;
# физическое устройство — по IP компьютера в локальной сети.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Стиль карты MapLibre (векторные тайлы OpenStreetMap). По умолчанию — OpenFreeMap.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Ссылка на политику обработки персональных данных (ФЗ-152), показывается на экране входа.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
